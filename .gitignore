# Dependencies (regenerable with `bun install` — never commit)
node_modules/

# npm lockfile — this is a Bun project (bun.lock is the tracked one).
# package-lock.json only exists because we used npm to sidestep a Bun
# install hang; it's a byproduct, not the source of truth (package.json is).
package-lock.json

# Secrets & environment (NEVER commit — contains DB password, JWT secret)
.env
.env.*.local

# Logs
*.log
npm-debug.log*

# Build output (frontend, later)
dist/
build/

# Uploaded firmware files (we store these locally during dev)
uploads/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

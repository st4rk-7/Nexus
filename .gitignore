.env
.env.*.local

# Logs
*.log
npm-debug.log*

# Build output
dist/
build/

# Legacy local uploads from before firmware moved to MongoDB GridFS
uploads/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

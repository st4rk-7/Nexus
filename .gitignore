# Dependencies (regenerable with `bun install` — never commit)
node_modules/

# npm lockfile — this is a Bun project (bun.lock is authoritative).
package-lock.json

# Secrets & environment (NEVER commit — contains DB password, JWT secret)
.env
.env.*.local

# Logs
*.log
npm-debug.log*

# Build output
dist/
build/

# Legacy local uploads from before firmware moved to MongoDB GridFS
uploads/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# DevOps generated state and local credentials
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
*.pem
*.key
kubeconfig
kubeconfig.*
!kubeconfig.example

# AI / editor agent files
.agents/
.claude/
AGENTS.md
CLAUDE.md
skills-lock.json

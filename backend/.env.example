# Local lab and deployment settings. Copy to .env; never commit the real .env.
PORT=3001
CLIENT_ORIGIN=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080

# Local MongoDB from `docker compose up -d mongo` (Compose overrides this to mongo:27017).
MONGODB_URI=mongodb://localhost:27017/nexus

# A long random string used to sign admin login tokens (JWT).
# Generate your own, e.g. with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

MAX_FIRMWARE_SIZE_MB=10

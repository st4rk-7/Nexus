# Template for the real .env file.
# Copy this to ".env" and fill in your own values. The real .env is NEVER committed.

PORT=3001

# Your MongoDB Atlas connection string. Get it from Atlas → Connect → Drivers.
# Replace <username>, <password>, and <cluster> with your own.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus_devops?appName=Cluster0

# A long random string used to sign admin login tokens (JWT).
# Generate your own, e.g. with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# The deployed React website allowed to call this API.
# Multiple origins can be comma-separated.
CLIENT_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# Keep this false after the first admin account has been created.
ALLOW_ADMIN_REGISTRATION=false

# Cloud-safe limits and status settings.
MAX_FIRMWARE_SIZE_MB=10
DEVICE_OFFLINE_AFTER_MINUTES=5

# Local backend settings. Copy to .env; never commit the real .env.
PORT=3001
CLIENT_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
# Local MongoDB started by Docker Compose. Use mongodb://mongo:27017/nexus in the backend container.
MONGODB_URI=mongodb://127.0.0.1:27017/nexus
# Replace with the output of: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string
# Demo admin is created once if it does not exist in MongoDB.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=nexus-lab-2026
ALLOW_ADMIN_REGISTRATION=false
MAX_FIRMWARE_SIZE_MB=10
DEVICE_OFFLINE_AFTER_MINUTES=5
